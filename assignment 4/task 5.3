import javax.swing.*;
import java.awt.*;
import java.awt.event.*;

public class Converter3 extends JFrame {

    JTextField amount = new JTextField(10);

    JComboBox<String> target = new JComboBox<>(
        new String[]{"USD", "EUR"}
    );

    JLabel result = new JLabel();

    public Converter3() {

        setLayout(new FlowLayout());

        JButton button = new JButton("Convert");

        add(amount);
        add(target);
        add(button);
        add(result);

        ActionListener handler = new ActionListener() {

            public void actionPerformed(ActionEvent e) {

                try {
                    double a = Double.parseDouble(amount.getText());

                    double rate = target.getSelectedItem()
                        .equals("USD") ? 0.012 : 0.011;

                    result.setText(
                        String.format("%.2f", a * rate)
                    );

                    JOptionPane.showMessageDialog(
                        Converter3.this, result.getText()
                    );

                } catch (Exception ex) {
                    result.setText("Invalid amount");

                    JOptionPane.showMessageDialog(
                        Converter3.this, "Invalid amount"
                    );
                }
            }
        };

        button.addActionListener(handler);
        amount.addActionListener(handler);

        setSize(300, 200);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setVisible(true);
    }

    public static void main(String[] args) {
        new Converter3();
    }
}
