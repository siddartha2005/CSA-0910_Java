import java.util.*;

class Student {
    private final String regNo;
    private final String name;

    Student(String regNo, String name) {
        this.regNo = regNo;
        this.name = name;
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (!(obj instanceof Student)) return false;
        Student other = (Student) obj;
        return regNo.equals(other.regNo);
    }

    @Override
    public int hashCode() {
        return Objects.hash(regNo);
    }

    @Override
    public String toString() {
        return regNo + " " + name;
    }
}

public class Q3_Attendance {
    public static void main(String[] args) {
        Set<Student> present = new HashSet<>();

        present.add(new Student("192311001", "Arun"));
        present.add(new Student("192311002", "Divya"));
        present.add(new Student("192311001", "Arun"));

        System.out.println("Unique students: " + present.size());
        System.out.println(present);

        Set<Student> scans = new HashSet<>();
        scans.add(new Student("192311003", "Kiran"));
        scans.add(new Student("192311003", "Kiran Kumar"));
        scans.add(new Student("192311004", "Meera"));

        System.out.println("Second test size: " + scans.size());
    }
}
