class ScannerStation extends Thread {
    private final String stationName;
    private final int scripts;

    ScannerStation(String stationName, int scripts) {
        this.stationName = stationName;
        this.scripts = scripts;
    }

    public void run() {
        try {
            for (int i = 1; i <= scripts; i++) {
                System.out.println(stationName + " scanned script " + i);
                Thread.sleep(200);
            }
            System.out.println(stationName + " completed " + scripts + " scripts.");
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            System.out.println(stationName + " was interrupted.");
        }
    }
}

class RunnableStation implements Runnable {
    private final String stationName;
    private final int scripts;

    RunnableStation(String stationName, int scripts) {
        this.stationName = stationName;
        this.scripts = scripts;
    }

    public void run() {
        try {
            for (int i = 1; i <= scripts; i++) {
                System.out.println(stationName + " scanned script " + i);
                Thread.sleep(200);
            }
            System.out.println(stationName + " completed " + scripts + " scripts.");
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
    }
}

public class ThreadLifeCycleDemo {
    public static void main(String[] args) throws InterruptedException {
        Thread[] stations = new Thread[4];

        stations[0] = new ScannerStation("Station 1", 3);
        stations[1] = new Thread(new RunnableStation("Station 2", 3));
        stations[2] = new Thread(new RunnableStation("Station 3", 3));
        stations[3] = new Thread(new RunnableStation("Station 4", 3));

        for (Thread station : stations) {
            station.start();
        }

        for (Thread station : stations) {
            station.join();
        }

        System.out.println("All scanner stations have finished.");
    }
}
