import java.sql.*;
public class TransactionAndLoginDemo {
    // Adjust URL/user/password for your local MySQL test database.
    static final String URL="jdbc:mysql://localhost:3306/transport";
    static final String USER="root", PASSWORD="your_password";
    static void transfer500(Connection c)throws SQLException {boolean old=c.getAutoCommit();c.setAutoCommit(false);try(Statement s=c.createStatement()){
        s.executeUpdate("UPDATE wallet SET balance=balance-500 WHERE wallet_id=1");
        s.executeUpdate("UPDATE wallet SET balance=balance+500 WHERE wallet_id=2");c.commit();
    }catch(SQLException e){c.rollback();throw e;}finally{c.setAutoCommit(old);}}
    static boolean safeLogin(Connection c,String id,String pwd)throws SQLException {String q="SELECT 1 FROM users WHERE id=? AND pwd=?";try(PreparedStatement p=c.prepareStatement(q)){p.setString(1,id);p.setString(2,pwd);try(ResultSet r=p.executeQuery()){return r.next();}}}
    static boolean unsafeLogin(Connection c,String id,String pwd)throws SQLException {String q="SELECT 1 FROM users WHERE id='"+id+"' AND pwd='"+pwd+"'";try(Statement s=c.createStatement();ResultSet r=s.executeQuery(q)){return r.next();}}
    public static void main(String[] args)throws Exception {try(Connection c=DriverManager.getConnection(URL,USER,PASSWORD)){System.out.println("Safe login test: "+safeLogin(c,"admin","wrong-password")); /* transfer500(c); */}}
}
