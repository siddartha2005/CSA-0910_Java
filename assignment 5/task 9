import java.io.*; import java.nio.file.*; import java.sql.*; import java.util.*;
public class MigratePassesAndMetadata {
    static final String URL="jdbc:mysql://localhost:3306/transport", USER="root", PASSWORD="your_password";
    static List<String[]> readValid(Path file,List<String> failures)throws IOException {List<String[]> rows=new ArrayList<>();try(BufferedReader br=Files.newBufferedReader(file)){String line;int lineNo=0;while((line=br.readLine())!=null){lineNo++;String[] f=line.split(",",-1);if(f.length!=5){failures.add("Line "+lineNo+": wrong field count: "+line);continue;}try{Integer.parseInt(f[3]);Double.parseDouble(f[4]);if(f[0].isBlank()||f[1].isBlank()||f[2].isBlank())throw new IllegalArgumentException("required field blank");rows.add(f);}catch(Exception e){failures.add("Line "+lineNo+": invalid record: "+line);}}}return rows;}
    static int migrate(Connection c,List<String[]> rows)throws SQLException {boolean old=c.getAutoCommit();c.setAutoCommit(false);String sql="INSERT INTO bus_pass(pass_id,reg_no,name,route_no,amount) VALUES(?,?,?,?,?)";int loaded=0;try(PreparedStatement p=c.prepareStatement(sql)){for(String[] x:rows){p.setString(1,x[0]);p.setString(2,x[1]);p.setString(3,x[2]);p.setInt(4,Integer.parseInt(x[3]));p.setDouble(5,Double.parseDouble(x[4]));p.addBatch();loaded++;if(loaded%1000==0)p.executeBatch();}p.executeBatch();c.commit();return loaded;}catch(SQLException|RuntimeException e){c.rollback();throw e;}finally{c.setAutoCommit(old);}}
    static void metadata(Connection c)throws SQLException {DatabaseMetaData m=c.getMetaData();System.out.println("DB: "+m.getDatabaseProductName()+" "+m.getDatabaseProductVersion());System.out.println("Driver: "+m.getDriverName()+" "+m.getDriverVersion());try(ResultSet r=m.getTables(null,null,"%",new String[]{"TABLE"})){while(r.next())System.out.println("Table: "+r.getString("TABLE_NAME"));}}
    public static void main(String[] args)throws Exception {Path input=Path.of(args.length>0?args[0]:"passes.csv");List<String> bad=new ArrayList<>();List<String[]> good=readValid(input,bad);try(Connection c=DriverManager.getConnection(URL,USER,PASSWORD)){System.out.println("Migrated rows: "+migrate(c,good));metadata(c);}System.out.println("Failed records:");bad.forEach(System.out::println);}
}
