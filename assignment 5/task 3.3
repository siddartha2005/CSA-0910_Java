import java.sql.*; import java.util.*;
public class StudentDao implements Dao<Student,Integer> {
    private final Connection con;
    public StudentDao(Connection con){this.con=con;}
    public void insert(Student s)throws SQLException { String q="INSERT INTO student(student_id,name,department,email) VALUES(?,?,?,?)";
        try(PreparedStatement p=con.prepareStatement(q)){p.setInt(1,s.getStudentId());p.setString(2,s.getName());p.setString(3,s.getDepartment());p.setString(4,s.getEmail());p.executeUpdate();}}
    public Student findById(Integer id)throws SQLException {try(PreparedStatement p=con.prepareStatement("SELECT * FROM student WHERE student_id=?")){p.setInt(1,id);try(ResultSet r=p.executeQuery()){return r.next()?new Student(r.getInt("student_id"),r.getString("name"),r.getString("department"),r.getString("email")):null;}}}
    public List<Student> findAll()throws SQLException {List<Student> list=new ArrayList<>();try(Statement s=con.createStatement();ResultSet r=s.executeQuery("SELECT * FROM student")){while(r.next())list.add(new Student(r.getInt("student_id"),r.getString("name"),r.getString("department"),r.getString("email")));}return list;}
    public void update(Student s)throws SQLException {try(PreparedStatement p=con.prepareStatement("UPDATE student SET name=?,department=?,email=? WHERE student_id=?")){p.setString(1,s.getName());p.setString(2,s.getDepartment());p.setString(3,s.getEmail());p.setInt(4,s.getStudentId());p.executeUpdate();}}
    public void delete(Integer id)throws SQLException {try(PreparedStatement p=con.prepareStatement("DELETE FROM student WHERE student_id=?")){p.setInt(1,id);p.executeUpdate();}}
}
