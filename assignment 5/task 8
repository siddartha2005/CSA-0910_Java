import java.sql.*; import java.util.*;
public class PassLoaderBenchmark {
    static final String URL="jdbc:mysql://localhost:3306/transport", USER="root", PASSWORD="your_password";
    static List<String[]> generate(int n){List<String[]> a=new ArrayList<>(n);for(int i=1;i<=n;i++)a.add(new String[]{"P"+i,"REG"+i,"Student"+i,String.valueOf(i%20),String.valueOf(1000.0+i)});return a;}
    static void clear(Connection c)throws SQLException {try(Statement s=c.createStatement()){s.executeUpdate("DELETE FROM bus_pass");}}
    static long statement(Connection c,List<String[]> data)throws SQLException {long start=System.nanoTime();try(Statement s=c.createStatement()){for(String[] x:data)s.executeUpdate("INSERT INTO bus_pass(pass_id,reg_no,name,route_no,amount) VALUES('"+x[0]+"','"+x[1]+"','"+x[2]+"',"+x[3]+","+x[4]+")");}return (System.nanoTime()-start)/1_000_000;}
    static long prepared(Connection c,List<String[]> data)throws SQLException {long start=System.nanoTime();try(PreparedStatement p=c.prepareStatement("INSERT INTO bus_pass(pass_id,reg_no,name,route_no,amount) VALUES(?,?,?,?,?)")){for(String[] x:data){p.setString(1,x[0]);p.setString(2,x[1]);p.setString(3,x[2]);p.setInt(4,Integer.parseInt(x[3]));p.setDouble(5,Double.parseDouble(x[4]));p.executeUpdate();}}return (System.nanoTime()-start)/1_000_000;}
    static long batch(Connection c,List<String[]> data)throws SQLException {long start=System.nanoTime();boolean old=c.getAutoCommit();c.setAutoCommit(false);try(PreparedStatement p=c.prepareStatement("INSERT INTO bus_pass(pass_id,reg_no,name,route_no,amount) VALUES(?,?,?,?,?)")){int k=0;for(String[] x:data){p.setString(1,x[0]);p.setString(2,x[1]);p.setString(3,x[2]);p.setInt(4,Integer.parseInt(x[3]));p.setDouble(5,Double.parseDouble(x[4]));p.addBatch();if(++k%1000==0)p.executeBatch();}p.executeBatch();c.commit();}catch(SQLException e){c.rollback();throw e;}finally{c.setAutoCommit(old);}return (System.nanoTime()-start)/1_000_000;}
    public static void main(String[] args)throws Exception {try(Connection c=DriverManager.getConnection(URL,USER,PASSWORD)){for(int n:new int[]{1000,10000,100000}){List<String[]> data=generate(n);clear(c);System.out.println(n+" Statement ms="+statement(c,data));clear(c);System.out.println(n+" Prepared ms="+prepared(c,data));clear(c);System.out.println(n+" Batch ms="+batch(c,data));clear(c);}}}
}
